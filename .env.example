DATABASE_URL=sqlite:///./sysdesign.db
AI_PROVIDER=mock
MESSAGING_PROVIDER=console
TIMEZONE=UTC
# For Meta WhatsApp Cloud API:
# MESSAGING_PROVIDER=meta
# META_ACCESS_TOKEN=<secret-manager value>
# META_PHONE_NUMBER_ID=<Meta phone number ID>
# META_GRAPH_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=<random webhook verification token>
# META_APP_SECRET=<Meta app secret, used to validate X-Hub-Signature-256>
# Set ADMIN_TOKEN and all WhatsApp credentials only through a secret manager.
